  "intentionalChanges": [
    {
      "id": "structured-css-candidate-identity",
      "behavior": "Resolved property identities survive completion rendering. Ambiguous t-a and text-a alternatives now produce margin-top: auto instead of reparsing margin-top-a as margin: top auto. String choice projections remain independently expandable.",
      "stage": "architecture-refactor",
      "tests": ["emmet2-css-choices-retain-resolved-property-identity"]
    },
    {
      "id": "markup-dialect-and-empty-class-expressions",
      "behavior": "React uses className/htmlFor and Solid uses class/for. The internal classList fallback becomes React className; authored classList is unchanged. Empty class fields become editable object keys and empty literal classes become an empty string expression. Frozen legacy cases markup-007, markup-015 and markup-016 retain their inputs with explicit corrected expectations. Required nonempty references and Unicode scalar characters fail with domain errors.",
      "stage": "architecture-refactor",
      "tests": ["emmet2-markup-dialects-own-attribute-mappings", "emmet2-markup-extension-fields-and-unicode", "emmet2-markup-class-inputs-have-domain-errors", "emmet2-markup-current-core-oracle"]
    },
    {
      "id": "editor-request-and-host-boundaries",
      "behavior": "All hosts validate confirmed analyses against the restored visible view. Web languages share exclusive part endpoints and standalone SCSS dialect discovery. Initial and delayed automatic failures invalidate completion tables; explicit failures remain diagnostic and cancellation propagates.",
      "stage": "architecture-refactor",
      "tests": ["emmet2-host-all-contexts-share-the-visible-view-boundary", "emmet2-host-callback-views-are-restored", "emmet2-host-errors-have-editor-boundaries", "emmet2-host-lazy-failure-invalidates-the-entire-table", "emmet2-host-cancellation-propagates-and-invalidates", "emmet2-host-debugging-keeps-the-original-error", "emmet2-host-change-during-batch-render-rejects-all-candidates", "emmet2-context-web-parts-use-exclusive-endpoints", "emmet2-context-web-file-dialect-and-revision"]
    },
    {
      "id": "external-host-completion-provider",
      "behavior": "External hosts can provide confirmed ranges and an immutable context revision to the existing completion session, with no built-in fallback or duplicate parser. Automatic and explicit completion share preview, prefix reuse, fields and insertion. Provider changes and source or context changes reject stale choices. The public context expansion API honors an explicit host indentation width.",
      "stage": "post-S8",
      "tests": ["emmet2-host-provider-is-the-only-context-authority", "emmet2-host-provider-validates-ranges-and-render-context", "emmet2-host-public-expansion-preserves-layout-fields-and-source", "emmet2-host-dispatcher-works-without-the-minor-mode", "emmet2-host-provider-completes-selectors-without-rule-bodies", "emmet2-host-completion-shares-auto-explicit-preview-and-acceptance", "emmet2-host-provider-classifies-once-per-revision-and-reuses-prefix", "emmet2-host-provider-changes-reject-stale-candidates"]
    },
    {
      "id": "shared-css-selector-boundaries",
      "behavior": "Automatic and explicit completion share structural pseudo-chain boundaries. Selector lists, attributes, escaped colons and combinators are preserved before the active chain. Spaced nested selectors remain selectors, while declarations retain ownership of their values. Selector commas do not enter property-list expansion or its confirmed-prefix cache.",
      "stage": "post-S8",
      "tests": ["emmet2-extract-css-selector-boundaries-are-structural", "emmet2-css-selector-prefix-preserves-authored-structure", "emmet2-stylesheet-selector-boundaries-share-completion-rules", "emmet2-stylesheet-selector-prefix-cannot-reclassify-a-value", "emmet2-capf-complex-selector-preview-typing-and-acceptance"]
    },
    {
      "id": "css-base-mode-hosts",
      "behavior": "Every css-base-mode descendant is a CSS host, including css-ts-mode, which is a sibling of css-mode rather than a child.",
      "stage": "post-S8",
      "tests": ["emmet2-stylesheet-css-ts-mode-is-a-css-host"]
    },
    {
      "id": "pseudo-selector-completion-shapes",
      "behavior": "Pseudo completion expands only selector names and arguments, without adding spaces, rule blocks or content declarations. Required pseudo-functions insert editable parentheses; optional functional forms retain bare names. CSS and SCSS never add an implicit ampersand; authored selector prefixes are preserved and the legacy underscore omission marker remains supported. Candidate rows show only the pseudo chain, while insertion retains the full selector. This intentionally updates legacy css-082 through css-093 without modifying their frozen fixtures.",
      "stage": "post-S8",
      "tests": ["emmet2-css-pseudo-kinds-and-editable-arguments", "emmet2-css-pseudo-prefix-is-explicit-in-every-syntax", "emmet2-css-pseudo-catalog-has-valid-shapes", "emmet2-css-pseudo-functions-aliases-and-fallback", "emmet2-capf-pseudo-menu-is-independent-of-insertion", "emmet2-capf-pseudo-preview-and-field-navigation", "emmet2-capf-pseudo-tail-edit-retains-only-current-choices", "emmet2-stylesheet-pseudo-completion-preserves-authored-tail", "emmet2-stylesheet-pseudos-complete-without-rule-bodies", "emmet2-css-legacy-css-083", "emmet2-css-legacy-css-086", "emmet2-css-legacy-css-090", "emmet2-css-legacy-css-092"]
    },
    {
      "id": "completion-first-css",
      "behavior": "Emmet CSS snippets and the C-j expansion command are removed. A project-owned search over pinned CSS data ranks properties, keyword values and inherited value sets; completion builds at most ten choices and accepting one is the only expansion. Snippet defaults and value presets such as gtc repeat() and cr rgb() are gone; b and ct remain authored aliases. Plain CSS at-rules no longer use Emmet templates. Known elements with a pseudo, such as button:hv, and HTML elements alone on a line offer completion; emmet2-complete uses the automatic gate in built-in CSS and the explicit contract elsewhere; a property before a single colon, such as display:fl, leaves its value to the host even on request.",
      "stage": "post-S8",
      "tests": ["emmet2-css-search-accuracy-gates", "emmet2-css-search-words-aliases-and-values", "emmet2-css-search-values-include-inherited-sets", "emmet2-css-search-chooses-properties-and-keywords", "emmet2-css-choices-begin-with-the-expansion", "emmet2-css-legacy-css-015", "emmet2-capf-confidence-and-host-gates", "emmet2-capf-explicit-command-warms-and-skips-automatic-gates", "emmet2-stylesheet-unspaced-values-stay-with-host-completion", "emmet2-context-lexical-real-point", "emmet2-mode-lifecycle-and-lazy-backend", "emmet2-stylesheet-canonical-names-and-keywords"]
    },
    {
      "id": "project-owned-css-fuzzy-search",
      "behavior": "Project-owned ordered matching replaces upstream scoring, requires distinct character positions, and searches pinned full CSS property names as well as aliases. Exact aliases retain priority; full property names preserve hyphens. M10, M and DIB consume case-insensitive matches. The matcher remains for highlighting, pseudo and at-rule choices and host queries; completion-first-css ranks properties.",
      "stage": "post-S8",
      "tests": ["emmet2-fuzzy-ordered-characters-and-positions", "emmet2-fuzzy-ranking-and-stable-ties", "emmet2-fuzzy-partial-is-explicit-and-never-reuses-characters", "emmet2-capf-fuzzy-search-includes-canonical-properties", "emmet2-capf-fuzzy-properties-continue-through-hyphens", "emmet2-css-search-accuracy-gates"]
    },
    {
      "id": "live-expansion-completion",
      "behavior": "Typing updates one completion session; known CSS prefixes offer distinct expansion choices. Rows show expansion text and only multiline results provide a formatted documentation panel.",
      "stage": "post-S8",
      "tests": ["emmet2-capf-corfu-typing-refreshes-without-hiding", "emmet2-capf-css-prefix-choices-and-distinct-acceptance", "emmet2-capf-corfu-alternative-fields-and-one-undo", "emmet2-capf-multiline-only-formatted-preview", "emmet2-stylesheet-property-prefix-offers-completion"]
    },
    {
      "id": "pending-css-completion-and-full-labels",
