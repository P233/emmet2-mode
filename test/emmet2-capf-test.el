(ert-deftest emmet2-capf-corfu-comma-retains-choices-and-continues-properties ()
  (dolist (input '("m10" "ta" "m10,p20"))
    (emmet2-test--with-css-completion input
      (corfu-auto--complete-deferred)
      (let ((table (nth 2 completion-in-region--data))
            (labels (mapcar #'cadr (cdr (corfu--affixate corfu--candidates)))))
        (cl-letf (((symbol-function 'corfu--popup-hide)
                   (lambda () (ert-fail "A pending comma must keep the popup visible"))))
          (insert ",")
          (let ((this-command 'self-insert-command)) (corfu--post-command))
          (should completion-in-region-mode)
          (should (eq table (nth 2 completion-in-region--data)))
          (should (equal (mapcar #'cadr (cdr (corfu--affixate corfu--candidates))) labels))
          (insert "ta")
          (let ((this-command 'self-insert-command)) (corfu--post-command))
          (should (> corfu--total 1))
          (should (cl-some (lambda (row) (string-suffix-p "text-align: center;" (cadr row)))
                           (cdr (corfu--affixate corfu--candidates)))))))))

(ert-deftest emmet2-capf-corfu-pending-comma-acceptance-and-undo ()
  (emmet2-test--with-css-completion "m10"
    (corfu-auto--complete-deferred)
    (let* ((props (nth 4 completion-in-region--data))
           (exit (plist-get props :exit-function))
           (old (car corfu--candidates)))
      (insert ",")
      (let ((this-command 'self-insert-command)) (corfu--post-command))
      (funcall exit old 'finished)
      (should (equal (buffer-string) ".a{m10,}"))
      (should completion-in-region-mode)
      (corfu-insert)
      (should (equal (buffer-string) ".a{margin: 10px;}"))
      (undo-only 1)
      (should (equal (buffer-string) ".a{m10,}")))))

