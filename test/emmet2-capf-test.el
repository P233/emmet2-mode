(ert-deftest emmet2-capf-corfu-typing-refreshes-without-hiding ()
  (dolist (action '(insert delete))
    (save-window-excursion
      (let ((result
             (emmet2-test--completion-session
              '(basic partial-completion) nil nil nil "m1" nil nil nil nil nil
              (lambda ()
                (set-window-buffer (selected-window) (current-buffer))
                (let* ((old-table (nth 2 completion-in-region--data))
                       (old-candidate (car corfu--candidates))
                       (exit (plist-get (nth 4 completion-in-region--data) :exit-function)))
                  (if (eq action 'insert) (insert "4") (delete-char -1))
                  (let ((before (buffer-string)))
                    (cl-letf (((symbol-function 'corfu--popup-hide)
                               (lambda () (ert-fail "Typing must not hide the popup"))))
                      (let ((this-command (if (eq action 'insert) 'self-insert-command 'delete-backward-char)))
                        (corfu--post-command)))
                    (should completion-in-region-mode)
                    (should (eq (nth 2 completion-in-region--data) old-table))
                    (funcall exit old-candidate 'finished)
                    (should (equal (buffer-string) before))
                    (should (equal (substring-no-properties (car corfu--candidates))
                                   (if (eq action 'insert) "m14" "m")))))))))
        (should-not (cadr result))))))

