(ert-deftest emmet2-capf-fuzzy-search-includes-canonical-properties ()
  (emmet2-test--with-css-completion "ins"
    (let* ((data (emmet2-capf)) (table (nth 2 data)) (props (nthcdr 3 data))
           (candidates (all-completions "ins" table))
           (labels (mapcar #'cadr (funcall (plist-get props :affixation-function) candidates)))
           (index (cl-position "inset-block: ;" labels :test #'equal)))
      (should (equal (car labels) "inset: ;"))
      (should-not (member "ins: ;" labels))
      (should (numberp index))
      (should (equal (cl-loop for i below (length (car labels))
                              when (get-text-property i 'face (car labels)) collect i) '(0 1 2)))
      (should (equal labels (mapcar #'cadr (funcall (plist-get props :affixation-function)
                                                   (all-completions "ins" table)))))
      (funcall (plist-get props :exit-function) (nth index candidates) 'finished)
      (should (equal (buffer-string) ".a{inset-block: ;}"))))
  (emmet2-test--with-css-completion "size"
    (let* ((data (emmet2-capf)) (props (nthcdr 3 data))
           (rows (funcall (plist-get props :affixation-function) (all-completions "size" (nth 2 data)))))
      (should (member "inline-size: ;" (mapcar #'cadr rows))))))

