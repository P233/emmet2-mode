    (should (functionp captured-table))
    (with-temp-buffer
      (insert "ul>li*3")
      (should-not (all-completions "ul>li*3" captured-table))
      (funcall exit "ul>li*3" 'finished)
      (should (equal (buffer-string) "ul>li*3")))))

