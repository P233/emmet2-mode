(require 'emmet2-capf-contract-test)
(require 'typescript-ts-mode)
(require 'yasnippet)
(require 'corfu-popupinfo)

(defmacro emmet2-test--with-css-completion (input &rest body)
  "Run BODY in a displayed CSS buffer containing INPUT, using real Corfu."
  (declare (indent 1) (debug t))
  `(save-window-excursion
     (with-temp-buffer
       (set-window-buffer (selected-window) (current-buffer))
       (css-mode) (insert ".a{" ,input "}") (backward-char)
       (emmet2-mode 1) (buffer-enable-undo)
       (let ((completion-styles '(basic partial-completion))
             (completion-category-defaults nil) (completion-category-overrides nil)
             (corfu-auto-prefix 1) (corfu-auto-trigger nil)
             (corfu-on-exact-match 'show) (corfu-preview-current nil)
             (last-command-event ?a))
         (cl-letf (((symbol-function 'corfu--popup-show) #'ignore)
                   ((symbol-function 'corfu--popup-hide) #'ignore)
                   ((symbol-function 'corfu--protect) #'funcall))
           (unwind-protect (progn ,@body)
             (when completion-in-region-mode (corfu-quit))))))))

(ert-deftest emmet2-capf-confidence-and-host-gates ()
  (dolist (case '((web-mode "div│" nil) (web-mode "custom-element│" nil)
                  (web-mode "a:link│" nil) (web-mode "!│" t)
                  (web-mode "ul>li*2│" t) (web-mode "div.card│" t)
                  (web-mode "<p>This is the end.│</p>" nil) (web-mode "<p>See e.g.│</p>" nil)
                  (web-mode "ul>li.│" t)
                  (tsx-ts-mode "const A=(<p>Hello world.│</p>);" nil)
                  (web-mode "<div title='ul>li*2│'></div>" nil)
                  (web-mode "<!-- ul>li*2│ -->" nil)
                  (css-mode ".a{margin│}" nil) (css-mode ".a{m│}" t)
                  (css-mode ".a{tac│}" t) (css-mode ".a{dn│}" t)
                  (scss-mode ".a{posr│}" t) (css-mode ".a{wf│}" t)
                  (css-mode ".a{all│}" nil) (css-mode ".a{unknownword│}" nil)
                  (css-mode ".a{display│}" nil) (css-mode ".a{ta│}" t)
                  (css-mode ".a{color:tac│}" nil) (css-mode "tac│" nil)
                  (css-mode ".a{/* tac│ */}" nil) (css-mode ".a{content: 'tac│'}" nil)
                  (css-mode ".a{m1│}" t) (css-mode ".a{mA│}" t)
                  (css-mode ".a{c#fff│}" t) (css-mode ".a{p!│}" t)
                  (css-mode ".a{p[1px]│}" t) (css-mode ".a{p(1 + 2)│}" t)
                  (css-mode ".a{m,p│}" t) (css-mode ".a{c+bg│}" t)
                  (css-mode ".a{color: m1│}" nil) (css-mode ".card│" nil)
                  (css-mode ".a{display:fl│}" nil) (css-mode ".a{--accent:re│}" nil)
                  (css-mode ".a{future-prop:foo│}" nil) (css-mode ".a{d:n│}" nil)
                  (css-mode ".a{_:hv│}" t) (css-mode ".a{button::be│}" t)
                  (css-mode "@│" nil) (css-mode "@md│" t)
                  (css-mode ":│" nil) (css-mode "_:hv│" t)
                  (css-mode "::b│" t) (css-mode "@media m1│" nil)
                  (fundamental-mode "ul>li*2│" nil)
                  (tsx-ts-mode "const A=(<main>ul>li*2│</main>);" t)
                  (tsx-ts-mode "const A=(<main>{items.ma│}</main>);" nil)
                  (tsx-ts-mode "const A=(<main style={{tac│}} />);" t)
                  (tsx-ts-mode "const A=(<main other={{tac│}} />);" nil)
                  (tsx-ts-mode "const A=()=>ul>li*2│;" nil)
                  (tsx-ts-mode "const A=(<main style={{m10│}} />);" t)))
    (ert-info ((format "%S" case))
      (with-temp-buffer
        (insert (nth 1 case))
        (search-backward "│") (delete-char 1)
        (let ((position (point)))
          (funcall (car case)) (goto-char position)
          (emmet2-context--prepare)
          (should (eq (not (null (emmet2-capf))) (nth 2 case))))))))

(ert-deftest emmet2-capf-lazy-results-and-expansion-display ()
  (emmet2-test--with-capf "p{界😀abcdefghijklmnop}*5"
    (let* ((expand (symbol-function 'emmet2--expand-analysis)) (calls 0)
           (data (emmet2-capf)) (table (nth 2 data)) (props (nthcdr 3 data))
           (abbr (buffer-string)))
      (cl-letf (((symbol-function 'emmet2--expand-analysis)
                 (lambda (analysis) (cl-incf calls) (funcall expand analysis))))
        (should (eq (completion-metadata-get (completion-metadata abbr table nil) 'category) 'emmet2))
        (should (= calls 0))
        (should (equal (all-completions abbr table) (list abbr)))
        (should (test-completion abbr table))
        (should (equal (try-completion abbr table) abbr))
        (let ((row (car (funcall (plist-get props :affixation-function)
                                 (all-completions abbr table)))))
          (should (equal (get-text-property 0 'display (car row)) ""))
          (should (equal (cadr row)
                         (string-join (make-list 5 "<p>界😀abcdefghijklmnop</p>") " ")))
          (should (equal (caddr row) "")))
        (should-not (plist-member props :annotation-function))
        (should (eq (funcall (plist-get props :company-kind) abbr) 'snippet))
        (should-not (plist-member props :company-prefix-length))
        (should (= calls 1))
        (should (equal (buffer-string) abbr))))))

(ert-deftest emmet2-capf-multiline-only-formatted-preview ()
  (unwind-protect
      (dolist (abbr '("m10+p20" "tac"))
        (with-temp-buffer
          (css-mode) (insert ".a{" abbr "}") (backward-char)
          (let* ((data (emmet2-capf)) (props (nthcdr 3 data))
                 (source (buffer-string))
                 (text (if (equal abbr "tac") "text-align: center;"
                         "margin: 10px;\n   padding: 20px;"))
                 (row (car (funcall (plist-get props :affixation-function)
                                    (all-completions abbr (nth 2 data))))))
            (should (equal (all-completions abbr (nth 2 data)) (list abbr)))
            (should (equal (cadr row) (if (equal abbr "tac") text "margin: 10px; padding: 20px;")))
            (if (equal abbr "tac")
                (should-not (funcall (plist-get props :company-doc-buffer) abbr))
              (with-current-buffer (funcall (plist-get props :company-doc-buffer) abbr)
                (should (equal (buffer-substring-no-properties (point-min) (point-max))
                               "margin: 10px;\npadding: 20px;"))
                (should (text-property-not-all (point-min) (point-max) 'face nil))))
            (should (equal (buffer-string) source))
            (funcall (plist-get props :exit-function) abbr 'finished)
            (should (equal (buffer-string) (concat ".a{" text "}"))))))
    (emmet2-preview-clear)))

(ert-deftest emmet2-capf-display-highlights-literal-matches-without-changing-results ()
  (dolist (case '(("tac" "text-align: center;" (0 5 12))
                  ("m10," "margin: 10px;" (0 8 9))
                  ("TAC" "text-align: center;" (0 5 12))
                  ("wf" "width: 100%;" nil)))
    (pcase-let* ((`(,input ,text ,positions) case)
                 (result (emmet2-result-create text))
                 (label (emmet2-capf--display (plist-get result :text) input)))
      (should (equal label text))
      (should (equal (cl-loop for i below (length label)
                              when (get-text-property i 'face label) collect i)
                     positions))
      (should-not (text-property-not-all 0 (length text) 'face nil (plist-get result :text))))))

(ert-deftest emmet2-capf-css-prefix-choices-and-distinct-acceptance ()
  (with-temp-buffer
    (css-mode) (insert ".a{ta}") (backward-char)
    (let* ((data (emmet2-capf)) (table (nth 2 data)) (props (nthcdr 3 data))
           (candidates (all-completions "ta" table))
           (rows (funcall (plist-get props :affixation-function) candidates))
           (labels (mapcar #'cadr rows)))
      (dolist (text '("text-align: ;" "text-align: left;" "text-align: center;"
                      "text-align: right;" "text-align: justify;" "text-align-last: ;"))
        (should (member text labels)))
      (should (= (length labels) (length (delete-dups (copy-sequence labels)))))
      (should (cl-every (lambda (candidate) (equal candidate "ta")) candidates))
      (let ((selected (nth (cl-position "text-align: right;" labels :test #'equal) candidates)))
        (funcall (plist-get props :exit-function) selected 'finished)
        (should (equal (buffer-string) ".a{text-align: right;}"))))))

(ert-deftest emmet2-capf-background-choices-stay-properties ()
  (emmet2-test--with-css-completion "bg"
    (let* ((data (emmet2-capf)) (props (nthcdr 3 data))
           (candidates (all-completions "bg" (nth 2 data)))
           (labels (mapcar #'cadr (funcall (plist-get props :affixation-function) candidates)))
           (index (cl-position "background: none;" labels :test #'equal)))
      (should (numberp index))
      (should-not (cl-some (lambda (label) (string-match-p "{" label)) labels))
      (funcall (plist-get props :exit-function) (nth index candidates) 'finished)
      (should (equal (buffer-string) ".a{background: none;}")))))

(ert-deftest emmet2-capf-corfu-alternative-fields-and-one-undo ()
  (dolist (yas '(nil t))
    (dolist (text '("text-align: right;" "text-align-last: ;"))
      (emmet2-test--with-css-completion "ta"
        (when yas (yas-minor-mode 1))
        (corfu-auto--complete-deferred)
        (should completion-in-region-mode)
        (let* ((candidates corfu--candidates)
               (rows (cdr (corfu--affixate candidates)))
               (index (cl-position text (mapcar #'cadr rows) :test #'equal))
               (this-command 'corfu-insert) (last-command nil))
          (should (> index 0))
          (should (cl-every (lambda (row) (equal (get-text-property 0 'display (car row)) "")) rows))
          (corfu--goto index)
          (corfu-insert)
          (should (equal (buffer-string) (concat ".a{" text "}")))
          (when (equal text "text-align-last: ;")
            (should (eq (not (null (yas-active-snippets))) yas))
            (should (eq (char-after) ?\;)))
          (undo-only 1)
          (should (equal (buffer-string) ".a{ta}"))
          (should-not (yas-active-snippets)))))))

