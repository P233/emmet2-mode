(ert-deftest emmet2-capf-classifies-each-context-revision-once ()
  ;; Each change is an input of the analysis, so it classifies the host again.
  (dolist (change (list nil (lambda (data) (goto-char (nth 1 data)))
                        (lambda (_) (narrow-to-region (point-min) (1- (point-max))))
                        (lambda (_) (setq-local web-mode-engine "php"))
                        (lambda (_) (setq-local web-mode-content-type "css"))))
    (with-temp-buffer
      (insert "<style>.a{m10}</style>") (web-mode) (emmet2-mode 1) (search-backward "10}</style>")
      (let ((analyze (symbol-function 'emmet2-context-analyze)) (calls 0))
        (cl-letf (((symbol-function 'emmet2-context-analyze)
                   (lambda (&rest args) (cl-incf calls) (apply analyze args))))
          (let* ((data (emmet2-capf)) (table (nth 2 data)) (props (nthcdr 3 data))
                 (candidates (all-completions "m10" table)))
            ;; Frontend queries of one revision reuse the table's classification.
            (dotimes (_ 3) (all-completions "m10" table) (test-completion "m10" table))
            (funcall (plist-get props :affixation-function) candidates)
            (funcall (plist-get props :company-doc-buffer) (car candidates))
            (should (= calls 1))
            (when change
              (funcall change data)
              (all-completions "m10" table)
              (should (> calls 1)))))))))

