(ert-deftest emmet2-capf-corfu-sass-variable-prefix-keeps-the-session ()
  (dolist (input '("p" "padding" "inset-b"))
    (emmet2-test--with-css-completion input
      (scss-mode) (emmet2-mode 1)
      (corfu-auto--complete-deferred)
      (let* ((table (nth 2 completion-in-region--data))
             (anchor (nth 0 completion-in-region--data))
             (exit (plist-get (nth 4 completion-in-region--data) :exit-function))
             (old (car corfu--candidates))
             (property (if (equal input "inset-b") "inset-block" "padding")))
        (cl-letf (((symbol-function 'corfu--popup-hide)
                   (lambda () (ert-fail "A Sass variable prefix must keep the popup visible"))))
          (dolist (part '("$" "-" "gutter"))
            (insert part)
            (let ((this-command 'self-insert-command)) (corfu--post-command))
            (should completion-in-region-mode)
            (should (eq table (nth 2 completion-in-region--data)))
            (should (equal anchor (nth 0 completion-in-region--data)))
            (should (string-prefix-p (concat property ": $")
                                     (cadar (cdr (corfu--affixate corfu--candidates)))))))
        (funcall exit old 'finished)
        (should (equal (buffer-string) (concat ".a{" input "$-gutter}")))
        (corfu-insert)
        (should (equal (buffer-string) (concat ".a{" property ": $-gutter;}")))
        (undo-only 1)
