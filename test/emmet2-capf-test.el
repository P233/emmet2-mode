(ert-deftest emmet2-capf-current-fragment-is-prepared-once-per-revision ()
  (emmet2-test--with-css-completion "ovh,ta"
    (let ((expand (symbol-function 'emmet2-css--program))
          (prefix (symbol-function 'emmet2-engine-stylesheet-render))
          (prepare (symbol-function 'emmet2-capf--preview-text))
          (display (symbol-function 'emmet2-capf--display))
          expanded (prefix-calls 0) (prepared 0) (displayed 0))
      (cl-letf (((symbol-function 'emmet2-css--program)
                 (lambda (abbreviation at-rule)
                   (push abbreviation expanded) (funcall expand abbreviation at-rule)))
                ((symbol-function 'emmet2-engine-stylesheet-render)
                 (lambda (declaration &rest options)
                   ;; The confirmed prefix is resolved and rendered once.
                   (when (equal (emmet2-stylesheet--node-name declaration) "overflow")
                     (cl-incf prefix-calls))
                   (apply prefix declaration options)))
                ((symbol-function 'emmet2-capf--preview-text)
                 (lambda (&rest args) (cl-incf prepared) (apply prepare args)))
                ((symbol-function 'emmet2-capf--display)
                 (lambda (&rest args) (cl-incf displayed) (apply display args))))
        (let* ((data (emmet2-capf)) (table (nth 2 data)) (props (nthcdr 3 data))
               (candidates (all-completions "ovh,ta" table))
               (calls (length expanded)))
          (should (= (cl-count "ovh" expanded :test #'equal) 1))
          (should (= prefix-calls 1))
          (should (= prepared (length candidates)))
          (should (= displayed (length candidates)))
          (dotimes (_ 3)
            (funcall (plist-get props :affixation-function) candidates)
            (dolist (candidate candidates) (funcall (plist-get props :company-doc-buffer) candidate)))
          (should (= calls (length expanded)))
          (should (= prepared (length candidates)))
          (should (= displayed (length candidates)))
          (insert "c")
          (let ((next (all-completions "ovh,tac" table)))
            (should (equal (cadar (funcall (plist-get props :affixation-function) next))
                           "text-align: center;"))
            (should (= (cl-count "ovh" expanded :test #'equal) 1))
            (should (= prefix-calls 1))
            (should (= prepared (+ (length next) (length candidates))))
            (should (= displayed (+ (length next) (length candidates))))))))))

