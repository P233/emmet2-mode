              (labels (mapcar #'cadr (cdr (corfu--affixate corfu--candidates)))))
          (cl-letf (((symbol-function 'corfu--popup-hide)
                     (lambda () (ert-fail "A pending separator must keep the popup visible"))))
            (insert separator)
            (let ((this-command 'self-insert-command)) (corfu--post-command))
            (should completion-in-region-mode)
