(ert-deftest emmet2-capf-css-in-js-alternative-keeps-host-formatting ()
  (with-temp-buffer
    (insert "const A=(<main style={{ta}} />);") (tsx-ts-mode)
    (search-backward "ta}}") (forward-char 2) (emmet2-mode 1)
    (emmet2-context-analyze)
    (let* ((data (emmet2-capf)) (props (nthcdr 3 data))
           (candidates (all-completions "ta" (nth 2 data)))
           (rows (funcall (plist-get props :affixation-function) candidates))
           (index (cl-position "textAlign: \"right\"" (mapcar #'cadr rows) :test #'equal)))
      (should index)
      (funcall (plist-get props :exit-function) (nth index candidates) 'finished)
      (should (equal (buffer-string) "const A=(<main style={{textAlign: \"right\"}} />);")))))

(ert-deftest emmet2-capf-corfu-multiline-to-single-line-hides-info-only ()
  (emmet2-test--with-css-completion "m10+p20"
    (corfu-auto--complete-deferred)
    (should (string-match-p "margin: 10px;\n" (corfu-popupinfo--get-documentation (car corfu--candidates))))
    (delete-region (- (point) 4) (point))
    (let ((this-command 'delete-backward-char)) (corfu--post-command))
    (should completion-in-region-mode)
    (let ((corfu-popupinfo--candidate nil)
          (corfu-popupinfo--function #'corfu-popupinfo--get-documentation)
          hidden)
      (cl-letf (((symbol-function 'corfu-popupinfo--visible-p) (lambda (&optional _) t))
                ((symbol-function 'corfu-popupinfo--hide) (lambda () (setq hidden t))))
        (corfu-popupinfo--show (car corfu--candidates)))
      (should hidden)
      (should completion-in-region-mode))))

(ert-deftest emmet2-capf-single-line-is-not-truncated-or-documented ()
  (emmet2-test--with-capf (concat "p{" (make-string 140 ?x) "}")
    (let* ((data (emmet2-capf)) (props (nthcdr 3 data))
           (candidate (car (all-completions (buffer-string) (nth 2 data))))
           (row (car (funcall (plist-get props :affixation-function) (list candidate)))))
      (should (equal (cadr row) (concat "<p>" (make-string 140 ?x) "</p>")))
      (should-not (funcall (plist-get props :company-doc-buffer) candidate)))))

(ert-deftest emmet2-capf-choices-are-lazy-and-reused-per-revision ()
  (emmet2-test--with-css-completion "ta"
    (let ((expand (symbol-function 'emmet2--expand-analysis)) (calls 0))
      (cl-letf (((symbol-function 'emmet2--expand-analysis)
                 (lambda (analysis) (cl-incf calls) (funcall expand analysis))))
        (let* ((data (emmet2-capf)) (table (nth 2 data)) (props (nthcdr 3 data)))
          (completion-metadata "ta" table nil)
          (should (= calls 0))
          (let ((candidates (all-completions "ta" table)))
            (should (> (length candidates) 1))
            (let ((expanded calls))
              (funcall (plist-get props :affixation-function) candidates)
              (all-completions "ta" table)
              (dolist (candidate candidates)
                (funcall (plist-get props :company-doc-buffer) candidate))
              (should (= expanded calls)))))))))

(ert-deftest emmet2-capf-css-keywords-through-corfu ()
  (dolist (case '(("tac" 3 "text-align: center;")
                  ("dn" 2 "display: none;") ("dn" 3 nil)
                  ("posr" 3 "position: relative;")))
    (with-temp-buffer
      (css-mode) (insert ".a{" (car case) "}") (backward-char) (emmet2-mode 1)
      (let ((corfu-auto-prefix (nth 1 case)) (corfu-auto-trigger nil)
            (corfu-on-exact-match 'show) (corfu-preview-current nil)
            (completion-styles '(basic partial-completion))
            (completion-category-defaults nil) (completion-category-overrides nil)
            (last-command-event (aref (car case) (1- (length (car case))))) shown)
        (cl-letf (((symbol-function 'corfu--candidates-popup) (lambda (&rest _) (setq shown t)))
                  ((symbol-function 'corfu--popup-hide) #'ignore)
                  ((symbol-function 'corfu--protect) #'funcall))
          (unwind-protect
              (progn
                (corfu-auto--complete-deferred)
                (should (eq (not (null shown)) (not (null (nth 2 case)))))
                (when shown (corfu-insert))
                (should (equal (buffer-string) (concat ".a{" (or (nth 2 case) (car case)) "}"))))
            (when completion-in-region-mode (corfu-quit))))))))

(ert-deftest emmet2-capf-rejects-every-stale-source ()
  (dolist (change '(outside delete-restore point mode narrow disabled options indent host buffer))
    (ert-info ((format "%s" change))
      (emmet2-test--with-capf "<main>ul>li*2</main>"
        (goto-char 14)
        (let* ((data (emmet2-capf)) (table (nth 2 data))
               (exit (plist-get (nthcdr 3 data) :exit-function))
               (abbr "ul>li*2"))
          (should (equal (all-completions abbr table) (list abbr)))
          (pcase change
            ('outside (save-excursion (goto-char (point-min)) (insert "x")))
            ('delete-restore (delete-char -1) (insert "2"))
            ('point (backward-char))
            ('mode (text-mode))
            ('narrow (narrow-to-region 8 14))
            ('disabled (emmet2-mode -1))
            ('options (setq-local emmet2-markup-variant "solid"))
            ('indent (setq-local web-mode-markup-indent-offset 9))
            ('host
             (let ((tick (buffer-chars-modified-tick)))
               (setq-local web-mode-content-type "jsx")
               (should (= tick (buffer-chars-modified-tick))))))
          (cl-flet ((reject ()
                      (let ((before (buffer-string)) (position (point)))
                        (should-not (all-completions abbr table))
                        (funcall exit abbr 'finished)
                        (should (equal (buffer-string) before))
                        (should (= position (point))))))
            (if (eq change 'buffer)
                (with-temp-buffer (insert "<main>ul>li*2</main>") (web-mode) (goto-char 14) (reject))
              (reject))))))))

(ert-deftest emmet2-capf-exit-status-and-candidate-guard ()
  (dolist (status '(exact sole nil cancelled))
    (emmet2-test--with-capf "ul>li*3"
      (let ((exit (plist-get (nthcdr 3 (emmet2-capf)) :exit-function)))
        (funcall exit "ul>li*3" status)
        (funcall exit "div.card" 'finished)
        (should (equal (buffer-string) "ul>li*3"))))))

(ert-deftest emmet2-capf-backend-failure-and-source-change ()
  (dolist (failure '(parse quit backend source))
    (emmet2-test--with-capf "ul>li*3"
      (let ((attempts 0))
        (cl-letf (((symbol-function 'emmet2--expand-analysis)
                   (lambda (_)
                     (cl-incf attempts)
                     (pcase failure
                       ('parse (signal 'emmet2-parse-error '("invalid" 0)))
                       ('quit (signal 'quit nil))
                       ('backend (signal 'emmet2-backend-error '("Expansion deadline exceeded")))
                       ('source (insert "4") (emmet2-result-create "unsafe"))))))
          (if (eq failure 'quit)
              (should (eq (condition-case nil (all-completions "ul>li*3" table)
                            (quit 'cancelled)) 'cancelled))
            ;; A failed session never retries the expansion or signals to the frontend.
            (should-not (all-completions "ul>li*3" table))
            (should-not (all-completions "ul>li*3" table))
            (should (= attempts 1)))
          (should (equal (buffer-string) (if (eq failure 'source) "ul>li*34" "ul>li*3"))))))))

(ert-deftest emmet2-capf-mode-registration-and-command-isolation ()
  (let ((global completion-at-point-functions))
    (with-temp-buffer
      (insert "div") (web-mode)
      (let ((other (lambda () (error "Other capf must not run"))))
        (setq-local completion-at-point-functions (list other))
        (emmet2-mode 1) (emmet2-mode 1)
        (should (equal completion-at-point-functions (list #'emmet2-capf other)))
        (should-error (emmet2-complete) :type 'user-error)
        (should (equal completion-at-point-functions (list #'emmet2-capf other)))
        (emmet2-mode -1)
        (should (equal completion-at-point-functions (list other)))))
    (should (equal completion-at-point-functions global))))

(ert-deftest emmet2-capf-explicit-command-warms-but-keeps-host-gate ()
  (with-temp-buffer
    (insert "const A=(<main>ul>li*2</main>);") (tsx-ts-mode) (search-backward "</main>")
    (let ((completion-in-region-function (lambda (_beg _end table &optional _pred)
                                           (should (test-completion "ul>li*2" table)) t)))
      (should-not (emmet2-capf))
      (emmet2-complete)
      (should (emmet2-capf))))
  (with-temp-buffer
    (insert "const A=()=>ul>li*2;") (tsx-ts-mode) (backward-char)
    (should-error (emmet2-complete) :type 'user-error))
  (with-temp-buffer
    (insert "const A=(<main>ul>li*2</main>);") (tsx-ts-mode) (search-backward "</main>")
    (cl-letf (((symbol-function 'treesit-language-available-p) (lambda (&rest _) nil)))
      (should-not (emmet2-capf))
      (should-error (emmet2-complete) :type 'user-error))))

