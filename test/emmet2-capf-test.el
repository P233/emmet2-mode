(ert-deftest emmet2-capf-lazy-results-and-expansion-display ()
  (emmet2-test--with-capf "p{界😀abcdefghijklmnop}*5"
    (let* ((expand (symbol-function 'emmet2-expand-analysis)) (calls 0)
           (data (emmet2-capf)) (table (nth 2 data)) (props (nthcdr 3 data))
           (abbr (buffer-string)))
      (cl-letf (((symbol-function 'emmet2-expand-analysis)
                 (lambda (analysis) (cl-incf calls) (funcall expand analysis))))
        (should (eq (completion-metadata-get (completion-metadata abbr table nil) 'category) 'emmet2))
        (should (= calls 0))
        (should (equal (all-completions abbr table) (list abbr)))
        (should (test-completion abbr table))
        (should (equal (try-completion abbr table) abbr))
        (let ((row (car (funcall (plist-get props :affixation-function)
                                 (all-completions abbr table)))))
          (should (equal (get-text-property 0 'display (car row)) ""))
          (should (equal (cadr row)
                         (string-join (make-list 5 "<p>界😀abcdefghijklmnop</p>") " ")))
          (should (equal (get-text-property 0 'emmet2--label (car row)) (cadr row)))
          (should (equal (caddr row) "")))
        (should-not (plist-member props :annotation-function))
        ;; Plain-text rows: no kind, so icon margin formatters stay inactive.
        (should-not (plist-member props :company-kind))
        (should-not (plist-member props :company-prefix-length))
        (should (= calls 1))
        (should (equal (buffer-string) abbr))))))

(ert-deftest emmet2-capf-multiline-only-formatted-preview ()
  (unwind-protect
      (dolist (abbr '("m10+p20" "tac"))
        (with-temp-buffer
          (css-mode) (insert ".a{" abbr "}") (backward-char)
          (let* ((data (emmet2-capf)) (props (nthcdr 3 data))
                 (source (buffer-string))
                 (text (if (equal abbr "tac") "text-align: center;"
                         "margin: 10px;\n   padding: 20px;"))
                 (row (car (funcall (plist-get props :affixation-function)
                                    (all-completions abbr (nth 2 data))))))
            (should (equal (car (all-completions abbr (nth 2 data))) abbr))
            ;; The row shows the last property; the preview keeps the rest.
            (should (equal (cadr row) (if (equal abbr "tac") text "padding: 20px;")))
            (if (equal abbr "tac")
                (should-not (funcall (plist-get props :company-doc-buffer) abbr))
              (with-current-buffer (funcall (plist-get props :company-doc-buffer) abbr)
                (should (equal (buffer-substring-no-properties (point-min) (point-max))
                               "margin: 10px;\npadding: 20px;"))
                (should (text-property-not-all (point-min) (point-max) 'face nil))))
            (should (equal (buffer-string) source))
            (funcall (plist-get props :exit-function) abbr 'finished)
            (should (equal (buffer-string) (concat ".a{" text "}"))))))
    (emmet2-preview-clear)))

(ert-deftest emmet2-capf-display-highlights-literal-matches-without-changing-results ()
  (dolist (case '(("tac" "text-align: center;" (0 5 12))
                  ("m10," "margin: 10px;" (0 8 9))
                  ("TAC" "text-align: center;" (0 5 12))
                  ("wf" "width: 100%;" nil)))
    (pcase-let* ((`(,input ,text ,positions) case)
                 (result (emmet2-result-create text))
                 (label (emmet2-capf--display (plist-get result :text) input)))
      (should (equal label text))
      (should (equal (cl-loop for i below (length label)
                              when (get-text-property i 'face label) collect i)
                     positions))
      (should-not (text-property-not-all 0 (length text) 'face nil (plist-get result :text))))))

(ert-deftest emmet2-capf-css-prefix-choices-and-distinct-acceptance ()
  (with-temp-buffer
    (css-mode) (insert ".a{ta}") (backward-char)
    (let* ((data (emmet2-capf)) (table (nth 2 data)) (props (nthcdr 3 data))
           (candidates (all-completions "ta" table))
           (rows (funcall (plist-get props :affixation-function) candidates))
           (labels (mapcar #'cadr rows)))
      (dolist (text '("text-align: ;" "text-align: left;" "text-align: center;"
                      "text-align: right;" "text-align: justify;" "touch-action: ;"))
        (should (member text labels)))
      (should (equal (car labels) "text-align: ;"))
      (should (<= (length labels) emmet2-capf--limit))
      (should (= (length labels) (length (delete-dups (copy-sequence labels)))))
      (should (cl-every (lambda (candidate) (equal candidate "ta")) candidates))
      (let ((selected (nth (cl-position "text-align: right;" labels :test #'equal) candidates)))
        (funcall (plist-get props :exit-function) selected 'finished)
        (should (equal (buffer-string) ".a{text-align: right;}"))))))

(ert-deftest emmet2-capf-pseudo-menu-is-independent-of-insertion ()
  (dolist (case '((":be" "::before" "::before")
                  ("_:be" "::before" "::before")
                  ("&:be" "::before" "&::before")
                  ("button:be" "::before" "button::before")
                  (".card:be" "::before" ".card::before")
                  ("&:hv:be" ":hover::before" "&:hover::before")
                  ("&::part" "::part()" "&::part()")
                  ("&:not" ":not()" "&:not()")))
    (emmet2-test--with-css-completion (car case)
      (let* ((data (emmet2-capf)) (props (nthcdr 3 data))
             (candidate (car (all-completions (car case) (nth 2 data))))
             (entry (get-text-property 0 'emmet2--choice candidate))
             (result (copy-tree (plist-get entry :result)))
             (row (car (funcall (plist-get props :affixation-function) (list candidate)))))
        (should (equal (cadr row) (cadr case)))
        (should (equal (nth 2 case) (plist-get result :text)))
        (should (text-property-not-all 0 (length (cadr row)) 'face nil (cadr row)))
        (should-not (funcall (plist-get props :company-doc-buffer) candidate))
        (should (equal (plist-get entry :result) result))
        (funcall (plist-get props :exit-function) candidate 'finished)
        (should (equal (buffer-string) (concat ".a{" (plist-get result :text) "}")))
        (should (= (point) (+ 4 (plist-get result :cursor))))))))

(ert-deftest emmet2-capf-pseudo-preview-and-cursor ()
  (dolist (mode '(css-mode scss-mode))
    (dolist (command '(corfu-auto--complete-deferred emmet2-complete))
      (dolist (case '(("&:fu" ":focus" "&:focus│")
                      (":be" "::before" "::before│")
                      (":af" "::after" "::after│")
                      ("&::be" "::before" "&::before│")
                      ("&::part" "::part()" "&::part(│)" "button")
                      ("&:not" ":not()" "&:not(│)" ".disabled")))
        (ert-info ((format "%S %S %S" mode command case))
          (emmet2-test--with-css-completion (car case)
            (unless (eq mode major-mode) (funcall mode) (emmet2-mode 1))
            (setq-local css-indent-offset 2)
            (let ((completion-in-region-function #'corfu--in-region-1))
              (funcall command)
              (when (eq command 'emmet2-complete) (corfu--exhibit)))
            (should (equal (cadar (cdr (corfu--affixate corfu--candidates))) (nth 1 case)))
            (should-not (corfu-popupinfo--get-documentation (car corfu--candidates)))
            (corfu-insert)
            (should (equal (concat (buffer-substring (point-min) (point)) "│"
                                   (buffer-substring (point) (point-max)))
                           (concat ".a{" (nth 2 case) "}")))
            (should-not mark-active)
            ;; Typed arguments land inside the parentheses.
            (when (nth 3 case)
              (insert (nth 3 case))
              (should (looking-at ")}"))))))))
  (emmet2-preview-clear))

(ert-deftest emmet2-capf-pseudo-tail-edit-retains-only-current-choices ()
  (emmet2-test--with-css-completion "&::b"
    (let* ((data (emmet2-capf)) (table (nth 2 data)) (props (nthcdr 3 data))
           (old (car (all-completions "&::b" table))))
      (should (equal (plist-get (get-text-property 0 'emmet2--choice old) :text) "&::before"))
      (insert "e")
      (save-excursion (insert " {}"))
      ;; The result stays the same, but the old source revision cannot insert.
      (funcall (plist-get props :exit-function) old 'finished)
      (should (equal (buffer-string) ".a{&::be {}}"))
      (let ((candidate (car (all-completions "&::be" table))))
        (should (equal (plist-get (get-text-property 0 'emmet2--choice candidate) :text) "&::before"))
        (funcall (plist-get props :exit-function) old 'finished)
        (should (equal (buffer-string) ".a{&::be {}}"))
        (funcall (plist-get props :exit-function) candidate 'finished)
        (should (equal (buffer-string) ".a{&::before {}}"))))))

(ert-deftest emmet2-capf-complex-selector-preview-typing-and-acceptance ()
