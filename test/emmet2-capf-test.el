(ert-deftest emmet2-capf-current-fragment-is-prepared-once-per-revision ()
  (emmet2-test--with-css-completion "ovh,ta"
    (let ((expand (symbol-function 'emmet2--expand-analysis))
          (prepare (symbol-function 'emmet2-capf--preview-text))
          (display (symbol-function 'emmet2-capf--display))
          expanded (prepared 0) (displayed 0))
      (cl-letf (((symbol-function 'emmet2--expand-analysis)
                 (lambda (analysis)
                   (push (plist-get analysis :abbr) expanded) (funcall expand analysis)))
                ((symbol-function 'emmet2-capf--preview-text)
                 (lambda (&rest args) (cl-incf prepared) (apply prepare args)))
                ((symbol-function 'emmet2-capf--display)
                 (lambda (&rest args) (cl-incf displayed) (apply display args))))
        (let* ((data (emmet2-capf)) (table (nth 2 data)) (props (nthcdr 3 data))
               (candidates (all-completions "ovh,ta" table))
               (calls (length expanded)))
          (should (= (cl-count "ovh" expanded :test #'equal) 1))
          (should (= prepared (length candidates)))
          (should (= displayed (length candidates)))
          (dotimes (_ 3)
            (funcall (plist-get props :affixation-function) candidates)
            (dolist (candidate candidates) (funcall (plist-get props :company-doc-buffer) candidate)))
          (should (= calls (length expanded)))
          (should (= prepared (length candidates)))
          (should (= displayed (length candidates)))
          (insert "c")
          (should (= (length (all-completions "ovh,tac" table)) 1))
          (should (= (cl-count "ovh" expanded :test #'equal) 2))
          (should (= prepared (1+ (length candidates))))
          (should (= displayed (1+ (length candidates)))))))))

(ert-deftest emmet2-capf-affixation-validates-the-whole-batch ()
  (emmet2-test--with-css-completion "ovh,ta"
    (let* ((data (emmet2-capf)) (props (nthcdr 3 data))
           (candidates (all-completions "ovh,ta" (nth 2 data)))
           (affix (plist-get props :affixation-function))
           (analyze (symbol-function 'emmet2-context-analyze)) (analyses 0))
      (should (> (length candidates) 1))
      (cl-letf (((symbol-function 'emmet2-context-analyze)
                 (lambda (&rest args) (cl-incf analyses) (apply analyze args))))
        (let ((rows (funcall affix candidates)))
          (should (= analyses 1))
          (should (equal (mapcar #'cadr rows)
                         (mapcar (lambda (candidate)
                                   (plist-get (get-text-property 0 'emmet2--choice candidate) :label))
                                 candidates)))
          (should (equal (mapcar #'car rows) candidates))))
      ;; Matching text from another table cannot borrow this table's result.
      (let ((foreign (car (all-completions "ovh,ta" (nth 2 (emmet2-capf))))))
        (should (equal (cadar (funcall affix (list foreign))) "")))
      ;; Display callbacks may not refresh an input revision after an edit.
      (insert "c")
      (should (cl-every (lambda (row) (equal (cadr row) "")) (funcall affix candidates)))
      (dolist (candidate candidates)
        (should-not (funcall (plist-get props :company-doc-buffer) candidate))
        (funcall (plist-get props :exit-function) candidate 'finished))
      (should (equal (buffer-string) ".a{ovh,tac}")))))

