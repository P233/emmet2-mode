(require 'ert)
(require 'emmet2-extensions)
(require 'emmet2-css)
(require 'emmet2-expand)

;; The legacy baseline used the rhythm-sass convention for parenthesized values.
(defconst emmet2-css-test--scale '(("font-size" . "ms") (t . "rhythm")))

;; These are copied baseline assertions, not results generated by the new engine.
;; Each former ordinal has its own durable ERT identity, including duplicate names.
(defconst emmet2-css-test--legacy-changes
  '(("css-015" . "grid-template-columns: ;")
    ("css-082" . ":focus")
    ("css-083" . ":hover::after")
    ("css-084" . ":focus")
    ("css-085" . ".c:focus")
    ("css-086" . ".c::first-letter")
    ("css-087" . "a.c1.c2#id:focus")
    ("css-088" . "a.c1.c2#id:first-child")
    ("css-089" . ":not(:first-child)")
    ("css-090" . ":not(:first-child)::after")
    ("css-091" . ":not(:first-child):not(:last-child)")
    ("css-092" . ":not(:first-child):not(:last-child)::before")
    ("css-093" . ":nth-child(2n-1)"))
  "Reviewed differences from the frozen legacy baseline.
Emmet snippet defaults such as repeat() for gtc were removed with the snippet
table; the search still chooses grid-template-columns.  Pseudo completion
leaves the selector open for chaining, without adding a rule block, content
declaration or implicit ampersand.")

(dolist (entry (with-temp-buffer
                 (insert-file-contents (expand-file-name "test/fixtures/css-legacy.json" emmet2-test-root))
                 (json-parse-buffer :object-type 'alist :array-type 'list :false-object nil)))
  (let ((input (alist-get 'abbreviation entry))
        (expected (or (cdr (assoc (alist-get 'id entry) emmet2-css-test--legacy-changes))
                      (alist-get 'text entry)))
        (css-in-js (alist-get 'cssInJs entry)))
    (eval `(ert-deftest ,(intern (concat "emmet2-css-legacy-" (alist-get 'id entry))) ()
             (should (equal (plist-get (emmet2-extensions-css ,input :css-in-js ,css-in-js
                                                               :scale-functions emmet2-css-test--scale)
                                       :text)
                            ,expected))) t)))

(ert-deftest emmet2-css-independent-fields-and-collapse ()
  (should (equal (emmet2-extensions-css "bd")
                 '(:text "border: ;" :fields ((8 8 1 "")) :cursor 8)))
  (should (equal (emmet2-extensions-css "c+bg")
                 '(:text "color: ;\nbackground: ;" :fields ((7 7 1 "") (21 21 2 "")) :cursor 7)))
  (should (equal (emmet2-extensions-css "m+p")
                 '(:text "margin: ;\npadding: ;" :fields ((8 8 1 "") (19 19 2 "")) :cursor 8)))
  (should (equal (emmet2-extensions-css "all")
                 '(:text "top: ;\nright: ;\nbottom: ;\nleft: ;"
                         :fields ((5 5 1 "") (14 14 2 "") (24 24 3 "") (32 32 4 "")) :cursor 5)))
  (dolist (abbr '("bd[solid]" "gtc[1fr 1fr]" "c--primary" "m(2)"))
    (should-not (plist-get (emmet2-extensions-css abbr :scale-functions emmet2-css-test--scale) :fields))))

(ert-deftest emmet2-css-authored-values-keep-the-best-property ()
  ;; A value need not be a keyword; the property abbreviation still expands.
  (dolist (pair '(("ff-inter" . "font-family: inter;") ("bgc-brand" . "background-color: brand;")
                  ("anim-fade" . "animation: fade;") ("c-brand10" . "color: brand 10px;")
                  ("t-a" . "top: auto;") ("inset-b10" . "inset-block: 10px;") ("dN" . "display: none;")))
    (ert-info ((car pair))
      (should (equal (plist-get (emmet2-extensions-css (car pair) :syntax 'css) :text) (cdr pair))))))

(ert-deftest emmet2-css-all-keywords-use-the-all-property ()
  ;; CSS-wide keywords belong to the real all property; other values use the alias.
  (dolist (pair '(("allu" . "all: unset;") ("all[unset]" . "all: unset;") ("all-unset" . "all: unset;")
                  ("allu!" . "all: unset !important;") ("allRl" . "all: revert-layer;")
                  ("all8" . "top: 8px;\nright: 8px;\nbottom: 8px;\nleft: 8px;")
                  ("allA" . "top: auto;\nright: auto;\nbottom: auto;\nleft: auto;")))
    (ert-info ((car pair))
      (should (equal (plist-get (emmet2-extensions-css (car pair) :syntax 'css) :text) (cdr pair)))))
  (let ((choices (emmet2-extensions-css-choices "all" :syntax 'css)))
    (should (equal (car choices) "top+right+bottom+left"))
    (should (equal (plist-get (emmet2-extensions-css (nth 1 choices) :syntax 'css) :text) "all: initial;"))))

(ert-deftest emmet2-css-scale-functions-are-opt-in-sass ()
  (should-error (emmet2-extensions-css "p(1)") :type 'emmet2-parse-error)
  (dolist (case '(("p(0)(2)" "padding: 0 rhythm(2);") ("fz(0)" "font-size: ms(0);")
                  ("t(-1)!" "top: rhythm(-1) !important;")))
    (ert-info ((car case))
      (should (equal (plist-get (emmet2-extensions-css (car case) :scale-functions emmet2-css-test--scale) :text)
                     (cadr case)))))
  (should (equal (plist-get (emmet2-extensions-css "p(1)" :scale-functions '(("padding" . "space"))) :text)
                 "padding: space(1);"))
  (dolist (case '((css nil) (scss t)))
    (should-error (emmet2-extensions-css "p(1)" :syntax (car case) :css-in-js (cadr case)
                                         :scale-functions emmet2-css-test--scale)
                  :type 'emmet2-parse-error))
  (should-error (emmet2-extensions-css "m(1)" :scale-functions '(("padding" . "space")))
                :type 'emmet2-parse-error)
  (should (funcall (get 'emmet2-css-scale-functions 'safe-local-variable) emmet2-css-test--scale))
  (should-not (funcall (get 'emmet2-css-scale-functions 'safe-local-variable) '((padding . "space")))))

(ert-deftest emmet2-css-collapse-includes-right-boundary-field ()
  (dolist (input '("unknown${1:a}-${2:b}${3}" "unknown${1:a}${2}"))
    (should (equal (emmet2-extensions-css input)
                   '(:text "unknown: ;" :fields ((9 9 1 "")) :cursor 9)))))

(ert-deftest emmet2-css-nested-and-quoted-separators ()
  (should (equal (emmet2-css--split "p[calc(1px + 2px), var(--x, 0)]+c" '(?+ ?,))
                 '("p[calc(1px + 2px), var(--x, 0)]" "c")))
  (should (equal (emmet2-extensions-css "p[calc(1px + 2px), var(--x, 0)]!+c")
                 '(:text "padding: calc(1px + 2px), var(--x, 0) !important;\ncolor: ;"
                         :fields ((57 57 1 "")) :cursor 57)))
  (should (equal (plist-get (emmet2-extensions-css "ct['😀,+\\\\path']+m0") :text)
                 "content: '😀,+\\\\path';\nmargin: 0;"))
  (dolist (input '("p[1" "p[1)" "p['a]" "p++m"))
    (should-error (emmet2-extensions-css input) :type 'emmet2-parse-error)))

(ert-deftest emmet2-css-js-escapes-and-fields ()
  (should (equal (emmet2-extensions-css "c+gtc" :css-in-js t)
                 '(:text "color: , gridTemplateColumns: "
                         :fields ((7 7 1 "") (30 30 2 "")) :cursor 7)))
  (should (equal (emmet2-extensions-css "ct[\"😀\\path\"]+m" :css-in-js t)
                 '(:text "content: \"\\\"😀\\\\path\\\"\", margin: "
                         :fields ((32 32 1 "")) :cursor 32)))
  (let* ((source (emmet2-result-create "x\"\\\n😀" '((0 4 1 "x\"\\\n") (5 5 2 ""))))
         (before (copy-tree source)))
    (should (equal (emmet2-css--map-chars source #'emmet2-engine-js-character)
                   '(:text "x\\\"\\\\\\n😀" :fields ((0 7 1 "x\\\"\\\\\\n") (8 8 2 "")) :cursor 0)))
    (should (equal source before)))
  (dolist (pair '(("12px 12px" . "\"12px 12px\"") ("12px !important" . "\"12px !important\"")
                   ("center" . "\"center\"") ("0" . "0") ("0.5" . "0.5")
                   ("-100" . "-100") ("12px" . "12")))
    (should (equal (plist-get (emmet2-extensions-css (concat "p[" (car pair) "]") :css-in-js t) :text)
                   (concat "padding: " (cdr pair)))))
  (let* ((declaration (emmet2-engine-stylesheet-declaration "--a-b" "x" :literal t))
         (before (copy-tree declaration t)))
    (should (equal (plist-get (emmet2-engine-stylesheet-render declaration t) :text)
                   "\"--a-b\": \"x\""))
    (should (equal declaration before))))

(ert-deftest emmet2-css-js-keeps-leading-zero-values-as-strings ()
  ;; These are CSS decimal spellings, but bare JS treats them as legacy octal
  ;; or rejects them in strict mode.  Preserve raw values through string output.
  (dolist (value '("010px" "08" "00.5px" "-010px"))
    (let ((input (concat "p[" value "]")))
      (should (equal (plist-get (emmet2-extensions-css input) :text)
                     (concat "padding: " value ";")))
      (should (equal (plist-get (emmet2-extensions-css input :css-in-js t) :text)
                     (concat "padding: \"" value "\""))))))

(ert-deftest emmet2-css-pseudo-functions-aliases-and-fallback ()
  (dolist (pair '((":h(+p)" . ":has(+ p)") (":dis" . ":disabled")
                   (":fo" . ":first-of-type") ("_:fo" . ":first-of-type") (".c:fo" . ".c:first-of-type")
                   (".c:f-l" . ".c::first-letter")
                   ("a.c1.c2#id:fo" . "a.c1.c2#id:first-of-type")
                   (":n(:f-c)" . ":not(:first-child)") ("a.c1.c2#id:f-c" . "a.c1.c2#id:first-child")
                   (":n(:f-c,:l-c)" . ":not(:first-child):not(:last-child)")
                   (":n-c(2n-1)" . ":nth-child(2n-1)")
                   (":is(:h(+p),:fu)" . ":is(:has(+ p), :focus)")
                   (":w(.a,.b)" . ":where(.a, .b)") (":lang(en,fr)" . ":lang(en, fr)")
                   (":h(>p,+q)" . ":has(> p, + q)")
                   (":popov" . ":popover-open")
                   (":hov:af" . ":hover::after") (":n(:l-c):af" . ":not(:last-child)::after")
                   (":be" . "::before") ("_:fc:be" . ":first-child::before")
                   (":n(.a,.b):be" . ":not(.a):not(.b)::before") ("a:before" . "a::before")))
    (ert-info ((car pair))
      (let ((text (cdr pair)))
        (should (equal (emmet2-extensions-css (car pair))
                       (list :text text :fields nil :cursor (length text)))))))
  (should (equal (emmet2-extensions-css ":af" :indent "  " :base-indent "    ")
                 '(:text "::after" :fields nil :cursor 7)))
  (should (equal (plist-get (emmet2-extensions-css "@i+") :text) "@i+"))
  (should (equal (plist-get (emmet2-extensions-css "@scop") :text) "@scope "))
  (should (equal (emmet2-extensions-css "@us")
                 '(:text "@use \"\";" :fields ((6 6 1 "")) :cursor 6))))

(ert-deftest emmet2-css-pseudo-prefix-is-explicit-in-every-syntax ()
  (dolist (syntax '(css scss))
    (dolist (case '((":be" "::before") ("_:be" "::before")
                    ("&:be" "&::before") ("button:be" "button::before")
                    (".card:be" ".card::before") (":hv:be" ":hover::before")))
      (ert-info ((format "%s %S" syntax case))
        (should (equal (emmet2-extensions-css (car case) :syntax syntax)
                       (list :text (cadr case) :fields nil :cursor (length (cadr case)))))))))

(ert-deftest emmet2-css-selector-prefix-preserves-authored-structure ()
  (dolist (prefix '(".a," ".a, " ".card[disabled]" "button[data-label='a:b']"
                    ".card>.child" ".card > .child" "&:not(.a,.b)>.child"
                    ".card\\:active" "[data-x='a,+b']" ".card:hover.active"
                    ".card:hover[data-x='a:b']"))
    (ert-info (prefix)
      (should (eq (emmet2-extensions-css-kind (concat prefix ":hv")) 'selector))
      (should (equal (plist-get (emmet2-extensions-css (concat prefix ":hv")) :text)
                     (concat prefix ":hover")))
      (let* ((result (emmet2-extensions-css (concat prefix ":be")))
             (text (plist-get result :text)))
        (should (equal text (concat prefix "::before")))
        (should (= (plist-get result :cursor) (length text)))))))

(ert-deftest emmet2-css-pseudo-kinds-and-editable-arguments ()
  (dolist (case '(("&:hv" "&:hover│") ("&:hv:fu" "&:hover:focus│")
                  (":not" ":not(│)") (":nc" ":nth-child(│)")
                  (":host" ":host│") (":host()" ":host(│)")
                  (":is(:not(),:focus)" ":is(:not(│), :focus)")
                  ("&::before" "&::before│")
                  ("&:af" "&::after│")
                  ("::part" "::part(│)")
                  ("::part(foo):hv" "::part(foo):hover│")
                  ("::cue" "::cue│")
                  ("::cue()" "::cue(│)")
                  ("::before::marker" "::before::marker│")
                  ("::slotted([data-x=\"\"])" "::slotted([data-x=\"\"])│")))
    (ert-info ((car case))
      (let* ((result (emmet2-extensions-css (car case)))
             (text (plist-get result :text)) (cursor (plist-get result :cursor)))
        (should (equal (concat (substring text 0 cursor) "│" (substring text cursor)) (cadr case)))))))

(ert-deftest emmet2-css-pseudo-catalog-has-valid-shapes ()
  ;; Cover every searchable name, including optional functional forms.  The
  ;; raw metadata also carries vendor names, intentionally absent from search.
  (dolist (name (emmet2-css-search-pseudos))
    (ert-info (name)
      (let* ((result (emmet2-extensions-css (concat ".a" name)))
             (text (plist-get result :text))
             (function (and (member name (gethash "pseudoFunctions" emmet2-css-search--overrides))
                            (not (member name '(":host" ":current" "::cue" "::cue-region"))))))
        (should (equal text (concat ".a" name (if function "()" ""))))
        (if function
            (progn
              (should (= (length (plist-get result :fields)) 1))
              (should (= (plist-get result :cursor) (+ 3 (length name)))))
          (should-not (plist-get result :fields))
          (should (= (plist-get result :cursor) (length text))))))))

(ert-deftest emmet2-css-double-colon-choices-stay-pseudo-elements ()
  (let ((choices (emmet2-extensions-css-choices "&::b")))
    (should (member "&::before" choices))
    (should (cl-every (lambda (choice) (string-prefix-p "&::" choice)) choices)))
  (should (member "&:blank" (emmet2-extensions-css-choices "&:b"))))

(ert-deftest emmet2-css-at-rules-follow-host-syntax ()
  ;; Plain CSS resolves among CSS at-rules only, never to Sass rules.
  (dolist (pair '(("@m" . "@media ") ("@media" . "@media ") ("@md" . "@media ") ("@f" . "@font-face ")
                  ("@i" . "@import ") ("@kf" . "@keyframes ")
                  ("@sup" . "@supports ") ("@fo" . "@font-face ") ("@fa" . "@font-face ")
                  ("@us" . "@us") ("@if" . "@if")))
    (ert-info ((car pair))
      (should (equal (plist-get (emmet2-extensions-css (car pair) :syntax 'css) :text) (cdr pair)))))
  (should (equal (plist-get (emmet2-extensions-css "@fo") :text) "@for $ from 1 {\n\t\n}"))
  (should (equal (plist-get (emmet2-extensions-css "@kf" :syntax 'scss) :text) "@keyframes ")))

(ert-deftest emmet2-css-layout-does-not-rewrite-literal-tabs ()
  (should (equal (emmet2-extensions-css "m+p" :base-indent "  ")
                 '(:text "margin: ;\n  padding: ;" :fields ((8 8 1 "") (21 21 2 "")) :cursor 8)))
  (should (equal (emmet2-extensions-css ".a\t:flt" :indent "  " :base-indent "    ")
                 '(:text ".a\t::first-letter" :fields nil :cursor 17)))
  (should (equal (plist-get (emmet2-extensions-css "p[a\tb]" :indent "  ") :text) "padding: a\tb;"))
  (should (equal (emmet2-extensions-css "@else" :indent "  " :base-indent "    ")
                 '(:text "@else {\n      \n    }" :fields ((14 14 1 "")) :cursor 14))))

(ert-deftest emmet2-css-whole-expansion-shares-deadline ()
  (let ((now 0.0) (emmet2-engine--timeout 1.0) deadlines)
    (cl-letf (((symbol-function 'float-time) (lambda (&rest _) now))
              ((symbol-function 'emmet2-engine-stylesheet-render)
               (lambda (&rest _)
                 (push emmet2-engine--deadline deadlines)
                 (cl-incf now 0.6)
                 (emmet2-result-create "top: ;" '((5 5 1 ""))))))
      (should-error (emmet2-extensions-css "t+r+b") :type 'emmet2-backend-error)
      (should (equal deadlines '(1.0 1.0))))))

(ert-deftest emmet2-css-opinionated-regression-inputs ()
  (dolist (pair '(("!" . "!important") ("p$a$b$c!" . "padding: $a $b $c !important;")
                   ("p(1)(2)(3)!" . "padding: rhythm(1) rhythm(2) rhythm(3) !important;")
                   ("all--gutter!" . "top: var(--gutter) !important;\nright: var(--gutter) !important;\nbottom: var(--gutter) !important;\nleft: var(--gutter) !important;")
                   ("p--a--b--c!" . "padding: var(--a) var(--b) var(--c) !important;")
                   ("p[var(--a) var(--b) var(--c)]!" . "padding: var(--a) var(--b) var(--c) !important;")
                   ("p!" . "padding: !important;") ("p--p" . "padding: var(--p);")
                   ("p[0 2px]" . "padding: 0 2px;")))
    (ert-info ((car pair))
      (should (equal (plist-get (emmet2-extensions-css (car pair) :scale-functions emmet2-css-test--scale) :text)
                     (cdr pair))))))

(ert-deftest emmet2-css-empty-value-pairs-become-fields ()
  ;; The cursor starts inside the first empty pair; the final exit stays at the end.
  (dolist (case '(("bgilg" nil "background-image: linear-gradient();" (34))
                  ("bgi[linear-gradient()]!" nil "background-image: linear-gradient() !important;" (34))
                  ("ct[\"\"]" nil "content: \"\";" (10))
                  ("bg[url(''), linear-gradient()]" nil "background: url(''), linear-gradient();" (17 37))
                  ("w[calc(100% - 2rem)]" nil "width: calc(100% - 2rem);" nil)
                  ("bgilg" t "backgroundImage: \"linear-gradient()\"" (34))))
    (ert-info ((format "%S" case))
      (let ((result (emmet2-extensions-css (car case) :css-in-js (nth 1 case))))
        (should (equal (plist-get result :text) (nth 2 case)))
        (should (equal (mapcar #'car (plist-get result :fields)) (nth 3 case)))
        (should (= (plist-get result :cursor) (or (car (nth 3 case)) (length (nth 2 case)))))))))

(ert-deftest emmet2-css-raw-and-nested-selector-regressions ()
  ;; Raw values belong to the extension layer, never to the core tokenizer.
  (should (equal (emmet2-extensions-css "t[all 0.3s]")
                 '(:text "top: all 0.3s;" :fields nil :cursor 14)))
  (should (equal (emmet2-extensions-css "trs[all 0.3s]")
                 '(:text "transition: all 0.3s;" :fields nil :cursor 21)))
  (should (equal (emmet2-extensions-css "ff[Arial,sans-serif]")
                 '(:text "font-family: Arial,sans-serif;" :fields nil :cursor 30)))
  (should (equal (emmet2-extensions-css ":hv:n(:fc)")
                 '(:text ":hover:not(:first-child)" :fields nil :cursor 24))))

(ert-deftest emmet2-css-canonical-properties-use-extension-values ()
  (dolist (pair '(("inset-block[10px]" . "inset-block: 10px;")
                   ("margin-left-10" . "margin-left: -10px;")
                   ("inset-block--space" . "inset-block: var(--space);")
                   ("inset-block(2)(-1)!" . "inset-block: rhythm(2) rhythm(-1) !important;")
                   ("font-family[Arial,sans-serif]" . "font-family: Arial,sans-serif;")))
    (ert-info ((car pair))
      (let ((result (emmet2-extensions-css (car pair) :scale-functions emmet2-css-test--scale)))
        (should (equal (plist-get result :text) (cdr pair)))
        (should-not (plist-get result :fields)))))
  (should (equal (plist-get (emmet2-extensions-css "margin-left-10,inset-block--space" :css-in-js t) :text)
                 "marginLeft: -10, insetBlock: \"var(--space)\"")))

(ert-deftest emmet2-css-alias-precedence-and-empty-alias-fallback ()
  (should (equal (emmet2-extensions-css ":fu")
                 '(:text ":focus" :fields nil :cursor 6)))
  (should (equal (emmet2-extensions-css "@fa")
                 '(:text "@font-face " :fields nil :cursor 11)))
  ;; Replace only the alias maps in a private copy.  Names, functions and
  ;; templates remain available, and the packaged overrides stay untouched.
  (let ((emmet2-css-search--overrides (copy-hash-table emmet2-css-search--overrides)))
    (dolist (key '("pseudoAliases" "atRuleAliases"))
      (puthash key (make-hash-table :test #'equal) emmet2-css-search--overrides))
    (should (equal (emmet2-extensions-css ":fu")
                   '(:text ":future" :fields nil :cursor 7)))
    (should (equal (emmet2-extensions-css "@fa")
                   '(:text "@font-face " :fields nil :cursor 11))))
  (should (equal (gethash ":fu" (gethash "pseudoAliases" emmet2-css-search--overrides)) ":focus"))
  (should (equal (gethash "@fa" (gethash "atRuleAliases" emmet2-css-search--overrides)) "@font-face")))

(ert-deftest emmet2-css-search-chooses-properties-and-keywords ()
  (dolist (pair '(("ins32" . "inset: 32px;") ("w--sidebar-width" . "width: var(--sidebar-width);")
                  ("inset-b10" . "inset-block: 10px;") ("t-a" . "top: auto;") ("m0-a" . "margin: 0 auto;")
                  ("M10" . "margin: 10px;") ("DIB" . "display: inline-block;") ("TAC" . "text-align: center;")
                  ("bd1#2s" . "border: 1px #222 solid;") ("r0" . "right: 0;") ("b0" . "bottom: 0;")
                  ("ct" . "content: ;") ("zzA" . "zz: a;") ("unknownword10" . "unknownword: 10px;")))
    (ert-info ((car pair))
      (should (equal (plist-get (emmet2-extensions-css (car pair)) :text) (cdr pair))))))

(ert-deftest emmet2-css-choices-begin-with-the-expansion ()
  (dolist (input '("ins32" "ta" "tac" "posa" "allA" "t-a" "inset-b" "w--s" "c#f" "button:hv" "@md" ":fc"))
    (ert-info (input)
      (let ((choices (emmet2-extensions-css-choices input)))
        (should (<= 1 (length choices) 10))
        (should (equal (emmet2-extensions-css (car choices)) (emmet2-extensions-css input)))
        (dolist (choice choices) (emmet2-extensions-css choice)))))
  ;; README shows this list.
  (should (equal (emmet2-extensions-css-choices "ta")
                 '("text-align" "text-align[center]" "text-align[end]" "text-align[justify]" "text-align[left]"
                   "text-align[right]" "top[auto]" "touch-action" "transition[all]" "text-decoration[auto]")))
  (should (equal (car (emmet2-extensions-css-choices "posa")) "position[absolute]+z-index"))
  (should (member "text-align" (emmet2-extensions-css-choices "t-a")))
  (should (equal (car (emmet2-extensions-css-choices "inset-b")) "inset-block"))
  (should (equal (emmet2-extensions-css-choices "ins32" :limit 2) '("inset32" "inset-inline32")))
  (should (equal (car (emmet2-extensions-css-choices "button:hv")) "button:hover"))
  (should (equal (car (emmet2-extensions-css-choices "@md" :syntax 'css)) "@media"))
  (should-not (emmet2-extensions-css-choices "unknownword"))
  (should-not (emmet2-extensions-css-choices ".card")))

(ert-deftest emmet2-css-choices-preserve-complete-obsolete-properties ()
  ;; Fuzzy search omits obsolete properties, but a complete authored name
  ;; must keep the same meaning through direct expansion and completion.
  (dolist (input '("clip" "clip!" "clip1" "clip[none]" "box-flex-group"))
    (dolist (limit '(1 2 10))
      (let ((choices (emmet2-extensions-css-choices input :limit limit)))
        (should (equal (car choices) input))
        (should (<= (length choices) limit))
        (should (equal (emmet2-extensions-css (car choices))
                       (emmet2-extensions-css input))))))
  (should (member "clip-path" (emmet2-extensions-css-choices "clip")))
  (should (member "margin[auto]" (emmet2-extensions-css-choices "margin"))))

(ert-deftest emmet2-css-choices-retain-resolved-property-identity ()
  ;; The old string round-trip changed margin-top + -a into margin: top auto.
  ;; A generated string alternative must express the same declaration as the
  ;; direct result, including fields and both renderer dialects.
  (dolist (query '("t-a" "text-a" "all" "clip" "ovh,t-a"))
    (dolist (js '(nil t))
      (let ((entries (plist-get (emmet2-css-completions query :css-in-js js) :choices)))
        (should entries)
        (dolist (entry entries)
          (should (equal (plist-get entry :result)
                         (emmet2-extensions-css (plist-get entry :abbreviation) :css-in-js js)))))))
  (let* ((entries (plist-get (emmet2-css-completions "t-a") :choices))
         (entry (cl-find "margin-top -a" entries :key (lambda (item) (plist-get item :abbreviation)) :test #'equal)))
    (should (equal (plist-get (plist-get entry :result) :text) "margin-top: auto;"))
    (should (equal (plist-get entry :label) "margin-top: auto;"))))

(ert-deftest emmet2-css-coalescing-preserves-distant-mirrors ()
  (should (equal (emmet2-extensions-css "unknown${1:a}${2:b}/${3:c}${2:b}")
                 '(:text "unknown: /;" :fields ((9 9 1 "") (10 10 1 "")) :cursor 9))))

(ert-deftest emmet2-css-explicit-values-retain-property-grammar ()
  (dolist (name (emmet2-css-search-property-names))
    (should (equal (emmet2-engine-stylesheet-property-prefix name) (concat name ": "))))
  ;; Unknown plain names stay literal, but an invalid leading hyphen is still
  ;; a parse error.  Removing the old empty expansion must not bypass grammar.
  (should (equal (plist-get (emmet2-extensions-css "unknown[1]") :text) "unknown: 1;"))
  (should-error (emmet2-extensions-css "-unknown[1]") :type 'emmet2-parse-error)
  (should (equal (emmet2-extensions-css "bg[linear-gradient()]!")
                 '(:text "background: linear-gradient() !important;"
                   :fields ((28 28 1 "")) :cursor 28))))

(ert-deftest emmet2-css-descriptor-choices-use-the-enclosing-at-rule ()
  (dolist (case '(("@font-face" "sr" "src" "src: ;")
                  ("@property" "synt" "syntax" "syntax: ;")
                  ("@property" "inherits" "inherits" "inherits: ;")
                  ("@page" "size" "size" "size: ;")
                  ("@counter-style" "add" "additive-symbols" "additive-symbols: ;")))
    (pcase-let ((`(,owner ,input ,name ,expected) case))
      (should-not (member name (emmet2-extensions-css-choices input)))
      (should-not (member name (emmet2-extensions-css-choices name :limit 1)))
      (should (member name (emmet2-extensions-css-choices input :at-rule owner)))
      (let ((result (emmet2-extensions-css input :at-rule owner)))
        (should (equal (plist-get result :text) expected))
        (should (plist-get result :fields)))))
  (should (equal (plist-get (emmet2-engine-expand "font-display:s" :preset 'stylesheet :at-rule "@font-face") :text)
                 "font-display: swap;"))
  (should (equal (plist-get (emmet2-extensions-css "inheritsT" :at-rule "@property") :text)
                 "inherits: true;"))
  (should (equal (plist-get (emmet2-extensions-css "src[url()]" :at-rule "@font-face") :fields)
                 '((9 9 1 "")))))

(ert-deftest emmet2-css-numeric-descriptors-share-unitless-formatting ()
  (dolist (case '(("@font-palette-values" "base-palette1" "base-palette: 1;")
                  ("@font-palette-values" "override-colors1#f" "override-colors: 1 #fff;")
                  ("@counter-style" "range1-3" "range: 1 3;")
                  ("@counter-style" "pad2\"0\"" "pad: 2 \"0\";")
                  ("@counter-style" "system-fixed1" "system: fixed 1;")
                  ("@counter-style" "additive-symbols10\"X\"" "additive-symbols: 10 \"X\";")))
    (pcase-let* ((`(,rule ,input ,expected) case)
                 (choice (car (emmet2-extensions-css-choices input :at-rule rule))))
      (ert-info (input)
        (should choice)
        (should (equal (plist-get (emmet2-extensions-css input :at-rule rule) :text) expected))
        (should (equal (emmet2-extensions-css choice :at-rule rule)
                       (emmet2-extensions-css input :at-rule rule)))))))

