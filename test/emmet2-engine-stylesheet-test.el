(require 'ert)
(require 'emmet2-engine-stylesheet)

(ert-deftest emmet2-stylesheet-canonical-names-and-keywords ()
  (dolist (case '(("inset-block10" . "inset-block: 10px;") ("max-inline-size:" . "max-inline-size: ;")
                  ("display" . "display: ;") ("top-a" . "top: auto;") ("margin0-a" . "margin: 0 auto;")
                  ("border1#2s" . "border: 1px #222 solid;") ("padding$a$b$c" . "padding: $a $b $c;")
                  ;; Unmatched literals and unknown names stay as written; the
                  ;; extension layer chooses properties before calling the core.
                  ("top-zz" . "top: zz;") ("m10" . "m: 10px;") ("unknown-a" . "unknown: a;")))
    (ert-info ((car case))
      (should (equal (plist-get (emmet2-engine-stylesheet-expand (car case)) :text) (cdr case))))))

(ert-deftest emmet2-stylesheet-canonical-property-negative-values ()
  (dolist (case '(("inset-block-10" . "inset-block: -10px;")
                  ("margin-left-10" . "margin-left: -10px;")
                  ("inset-block-end-.5" . "inset-block-end: -0.5rem;")
                  ("margin-10+inset-inline-start-2" . "margin: -10px;\ninset-inline-start: -2px;")))
    (ert-info ((car case))
      (should (equal (plist-get (emmet2-engine-stylesheet-expand (car case)) :text) (cdr case))))))

(ert-deftest emmet2-stylesheet-units-colors-and-unitless-properties ()
  (dolist (case '(("margin10" . "margin: 10px;") ("margin.5" . "margin: 0.5rem;")
                  ("margin1e" . "margin: 1em;") ("margin1p" . "margin: 1%;") ("margin1x" . "margin: 1ex;")
                  ("margin1r" . "margin: 1rem;") ("margin0" . "margin: 0;") ("z-index10" . "z-index: 10;")
                  ("line-height1.5" . "line-height: 1.5;") ("opacity.5" . "opacity: 0.5;")
                  ("color#f" . "color: #fff;") ("color#fc0" . "color: #fc0;") ("color#3.5" . "color: rgba(51, 51, 51, 0.5);")
                  ("background-color#t" . "background-color: transparent;") ("padding1-2" . "padding: 1px 2px;")
                  ("margin10!" . "margin: 10px !important;")))
    (ert-info ((car case))
      (should (equal (plist-get (emmet2-engine-stylesheet-expand (car case)) :text) (cdr case))))))

