                  ("column-count2" . "column-count: 2;")
                  ("grid-row-start2" . "grid-row-start: 2;")
                  ("grid-column-end-1" . "grid-column-end: -1;")
                  ("grid-column1/3" . "grid-column: 1 / 3;")
                  ("animation-iteration-count1.5" . "animation-iteration-count: 1.5;")
                  ("border-image-slice30" . "border-image-slice: 30;")
                  ("fill-opacity.5" . "fill-opacity: 0.5;")
                  ("flood-opacity.5" . "flood-opacity: 0.5;")
                  ("stop-opacity.5" . "stop-opacity: 0.5;")
                  ("stroke-opacity.5" . "stroke-opacity: 0.5;")
                  ("stroke-miterlimit4" . "stroke-miterlimit: 4;")
                  ("font-size-adjust.5" . "font-size-adjust: 0.5;")
                  ("shape-image-threshold.5" . "shape-image-threshold: 0.5;")
                  ("scale2" . "scale: 2;")
                  ("aspect-ratio2" . "aspect-ratio: 2;")
                  ("aspect-ratio16/9" . "aspect-ratio: 16 / 9;")
                  ("orphans2" . "orphans: 2;")
                  ("widows2" . "widows: 2;")
                  ("math-depth2" . "math-depth: 2;")
                  ("line-clamp3" . "line-clamp: 3;")
                  ("max-lines3" . "max-lines: 3;")
                  ("hyphenate-limit-chars3" . "hyphenate-limit-chars: 3;")
                  ("initial-letter2" . "initial-letter: 2;")
                  ("mask-border-slice20" . "mask-border-slice: 20;")
                  ("reading-order2" . "reading-order: 2;")
                  ("text-combine-upright:digits2" . "text-combine-upright: digits 2;")
