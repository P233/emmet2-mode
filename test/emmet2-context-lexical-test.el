(ert-deftest emmet2-context-lexical-real-point ()
  (dolist (fixture emmet2-test-lexical-cases)
    (pcase-let ((`(,mode ,source ,language ,abbreviation ,position ,auto) fixture))
      (ert-info ((format "%s %s" mode source))
        (with-temp-buffer
          (insert source) (funcall mode)
          (goto-char (point-min)) (search-forward "│") (delete-char -1)
          (let* ((point-before (point)) (original (buffer-substring-no-properties (point-min) (point-max)))
                 (result (emmet2-context-analyze)))
            (should (equal (plist-get result :lang) language))
            (should (equal (plist-get result :abbr) abbreviation))
            (should (equal (plist-get result :position) position))
            (should (equal (emmet2-context-analyze t) (when auto result)))
            (should (equal (buffer-substring-no-properties (point-min) (point-max)) original))
            (should (= (point) point-before))
            (should-not (emmet2-context--parsers))))))))

(ert-deftest emmet2-context-web-engine-blocks-bound-markup ()
  (dolist (case '(("django" "<div>{% if x %}ul>li│{% endif %}</div>" "ul>li")
                  ("django" "<div>{{ x }}ul>li│</div>" "ul>li")
                  ("django" "<div>span│{{ msg }}</div>" "span")
                  ("django" "<div>{{ ul>li│ }}</div>" nil)
                  ("svelte" "{#if x}ul>li│{/if}" "ul>li")
                  ("vue" "<div>span│{{ msg }}</div>" "span")))
    (ert-info ((format "%S" case))
      (with-temp-buffer
        (insert (nth 1 case)) (web-mode) (web-mode-set-engine (car case))
        (goto-char (point-min)) (search-forward "│") (delete-char -1)
        (should (equal (plist-get (emmet2-context-analyze) :abbr) (nth 2 case)))
        (should (equal (plist-get (emmet2-context-analyze t) :abbr) (nth 2 case)))))))

(ert-deftest emmet2-context-web-style-language-uses-real-attribute ()
  (dolist (case '(("lang=\n\"scss\"" scss)
                  ("LANG='SCSS'" scss)
                  ("lang=scss" scss)
                  ("data-lang=\"scss\"" css)
                  ("title=\"lang='scss'\"" css)
                  ("lang=\"scss\" data-lang=\"css\"" scss)
                  ("title='<style>' lang='scss'" scss)
                  ("lang='scss-extra'" css)
                  ("lang='less'" css)))
    (ert-info ((car case))
      (with-temp-buffer
        (insert "<style\n " (car case) ">@us│</style>")
        (web-mode) (search-backward "│") (delete-char 1)
        (let ((source (buffer-string)) (position (point)))
          (should (eq (plist-get (emmet2-context-analyze) :syntax) (cadr case)))
          (should (eq (plist-get (emmet2-context-analyze t) :syntax) (cadr case)))
          (should (equal source (buffer-string)))
          (should (= position (point))))))))

