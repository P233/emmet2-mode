;; All 38 planning probes are assertions; full real-point extraction is tested
;; separately below so supplied abbreviation bounds cannot hide scanner bugs.

(defconst emmet2-test-css-position-cases
  '((".card at top level"            ".a { color: red; }\n⟨.card\n"                     css-mode  (css . selector))
             ("@md at top level"              ".a { }\n⟨@md\n"                                    css-mode  (css . selector))
             ("after {"                       ".a {\n  ⟨posa\n}\n"                               css-mode  (css . declaration-start))
             ("after ;"                       ".a {\n  color: red;\n  ⟨posa\n}\n"                css-mode  (css . declaration-start))
             ("same line after ;"             ".a { color: red; ⟨posa }\n"                       css-mode  (css . declaration-start))
             ("value"                         ".a {\n  color: ⟨re\n}\n"                          css-mode  (css . value))
             ("value continuation line"       ".a {\n  margin: 0\n  ⟨au\n}\n"                    css-mode  (css . value))
             ("inside parens"                 ".a { color: rgba(⟨ }\n"                           css-mode  (css . paren-args))
             ("inside raw-value brackets"     ".a {\n  p[1px ⟨]\n}\n"                            css-mode  (css . brackets))
             ("comment"                       ".a { /* ⟨posa */ }\n"                             css-mode  (css . comment))
             ("string"                        ".a { content: \"⟨po\" }\n"                        css-mode  (css . string))
             ("scss nested selector"          ".a {\n  color: red;\n  ⟨&:hv\n}\n"                scss-mode (css . declaration-start))
             ("scss after nested block"       ".a {\n  &:hover { color: red; }\n  ⟨posa\n}\n"    scss-mode (css . declaration-start))
             ("scss @include prelude"         ".a {\n  @include ⟨mi\n}\n"                        scss-mode (css . at-rule-prelude))
             ("scss @in at line start"        ".a {\n  ⟨@in\n}\n"                                scss-mode (css . declaration-start))
             ("@media ( prelude"              "@media (⟨\n"                                      css-mode  (css . paren-args))
             ("@media scr prelude"            "@media ⟨scr\n"                                    css-mode  (css . at-rule-prelude))))

(defconst emmet2-test-web-position-cases
  '(("text content"                  "<div>\n  <p>⟨ul>li*3</p>\n</div>\n"               web-mode (markup))
             ("bare text line"                "<div>\n  ⟨ul>li*3\n</div>\n"                      web-mode (markup))
             ("attribute name <div cl|"       "<div ⟨cl>x</div>\n"                               web-mode (none))
             ("class value"                   "<div class=\"⟨x\">y</div>\n"                      web-mode (none))
             ("style value"                   "<div style=\"⟨c\">y</div>\n"                      web-mode (css . declaration-start))
             ("style value, another style attr later on the line" "<div style=\"⟨c\"></div><div style=\"m\"></div>\n" web-mode (css . declaration-start))
             ("style value, single quotes"    "<div style='⟨m10'></div>\n"                       web-mode (css . declaration-start))
             ("style value after ;"           "<div style=\"color: red; ⟨m\">x</div>\n"          web-mode (css . declaration-start))
             ("style value position"          "<div style=\"color: ⟨re\">x</div>\n"              web-mode (css . value))
             ("<style> declaration-start"     "<style>\n.a {\n  ⟨posa\n}\n</style>\n"            web-mode (css . declaration-start))
             ("<style> selector"              "<style>\n.a { color: red; }\n⟨.b\n</style>\n"      web-mode (css . selector))
             ("<style> value"                 "<style>\n.a { color: ⟨re }\n</style>\n"            web-mode (css . value))
             ("<style> comment"               "<style>\n/* ⟨posa */\n</style>\n"                  web-mode (none))
             ("<style> brace inside comment before" "<style>\n/* { */\n.a {\n  ⟨posa\n}\n</style>\n" web-mode (css . declaration-start))
             ("<style> brace inside string before"  "<style>\n.a { content: \"{\"; ⟨posa }\n</style>\n" web-mode (css . declaration-start))
             ("<script>"                      "<script>\n  ⟨ul>li\n</script>\n"                  web-mode (none))
             ("html comment"                  "<!-- ⟨ul>li -->\n"                                web-mode (none))
             ("apostrophe earlier in text"    "<p>don't</p>\n<p>⟨ul>li</p>\n"                    web-mode (markup))
             ("astro text"                    "---\nconst a = 1;\n---\n<main>\n  ⟨ul>li\n</main>\n" web-mode (markup) "astro")
             ("svelte text"                   "<script>let a = 1;</script>\n<main>\n  ⟨ul>li\n</main>\n" web-mode (markup) "svelte")
             ("astro {expr} (known limitation: not marked by web-mode)" "---\n---\n<main>{items.⟨ma}</main>\n" web-mode (markup) "astro")))

(ert-deftest emmet2-context-css-position-prototypes ()
  (dolist (fixture emmet2-test-css-position-cases)
    (pcase-let ((`(,name ,source ,mode ,expected) fixture))
      (ert-info (name)
        (with-temp-buffer
          (insert source) (funcall mode)
          (goto-char (point-min)) (search-forward "⟨") (delete-char -1)
          (should (equal (cons 'css (emmet2-context--css-position
                                    (point-min) (point) nil (save-excursion (syntax-ppss))))
                         expected)))))))

(ert-deftest emmet2-context-web-position-prototypes ()
  (dolist (fixture emmet2-test-web-position-cases)
    (pcase-let ((`(,name ,source ,mode ,expected . ,engine) fixture))
      (ert-info (name)
        (with-temp-buffer
          (insert source) (funcall mode)
          (when engine (web-mode-set-engine (car engine)))
          (goto-char (point-min)) (search-forward "⟨") (delete-char -1)
          (emmet2-context--js-region)
          (let* ((region (emmet2-context--web-region))
                 (position (when (eq (car region) 'css)
                             (emmet2-context--css-position
                              (nth 1 region) (point) (nth 3 region)
                              (save-excursion
                                (with-syntax-table css-mode-syntax-table
                                  (parse-partial-sexp (nth 1 region) (point)))))))
                 (result (cond ((or (not region) (memq position '(string comment))) '(none))
                               ((eq (car region) 'markup) '(markup))
                               (t (cons 'css position)))))
            (should (equal result expected))))))))

